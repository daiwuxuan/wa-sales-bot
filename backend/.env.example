# 复制成 .env 后填写。.env 已在 .gitignore 里，不要提交。
#
# 这个文件里的任何变量都只被后端读取。
# 前端永远拿不到 OPENAI_API_KEY —— 前端只跟 FastAPI 说话。

# ── OpenAI ────────────────────────────────────────────────
# 留空 = 自动降级到本地规则式 Mock LLM，整条链路照样跑通。
# 填上 = 走真实 GPT-4o，其它代码一行都不用改。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# auto | openai | mock
#   auto   —— 有 key 走 openai，没 key 走 mock，探活失败也降级（推荐）
#   openai —— 强制真实调用，失败即报错（用于确认线上真的接上了）
#   mock   —— 强制 Mock，即使配了 key 也不发请求（省钱、离线开发）
LLM_MODE=auto

# ── 数据库 ────────────────────────────────────────────────
# 默认落在 <项目根>/data/app.db。绝对路径，不走相对路径解析。
# 切 Postgres 只改这一行：
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/wa_sales
DATABASE_URL=

# ── 对外地址 ──────────────────────────────────────────────
# 数据库里只存图片的相对 key（uploads/xxx.jpg），
# 绝对 URL 由这个前缀拼出来。将来换 CDN/S3 只改这里。
PUBLIC_BASE_URL=http://localhost:8000

# ── 后台 ──────────────────────────────────────────────────
# 演示期不启用鉴权，留空即可。要暴露到公网必须先设置。
ADMIN_TOKEN=

# 单笔订单超过这个金额（单位：分）不自动下单，转人工审核
AUTO_ORDER_MAX_CENTS=200000

# 报价有效期（分钟）
QUOTE_TTL_MINUTES=30
